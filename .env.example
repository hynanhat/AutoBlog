# ========================================================
# AutoBlog & OCR Hiragana - File mẫu cấu hình biến môi trường
# Sao chép tệp này thành .env và điền thông tin của bạn.
# ========================================================

# 1. Khóa Gemini API Key (Bắt buộc để OCR Hiragana tự động)
# Lấy miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Mô hình Gemini (Khuyên dùng: gemini-3.1-flash-lite hoặc gemini-2.5-flash)
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite
# 3. Địa chỉ OCR Server (Mặc định: http://127.0.0.1:8000)
OCR_HIRAGANA_URL=http://127.0.0.1:8000

# 4. Điền sẵn địa chỉ Gmail và App Password trên tab Đăng ký tài khoản (tùy chọn)
# GMAIL_INBOX_USER=your_gmail@gmail.com
# GMAIL_APP_PASSWORD=your_16_char_app_password
