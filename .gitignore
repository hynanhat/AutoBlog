# ========================================================
# Git Ignore Rules for AutoBlog & OCR Hiragana
# ========================================================

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.ruff_cache/
.pytest_cache/

# Environment variables & Secrets (TUYỆT ĐỐI KHÔNG COMMIT .env)
.env
.env.*
!.env.example
api_keys.txt
.key_usage.json
gmail_oauth_client.json
client_secret_*.apps.googleusercontent.com.json

# User Data & Account Credentials
*.csv
!ocr/data/*.csv
posts.txt
accounts.txt
errors/
logs/
*.log
hiragana/
ocr_cursor.json
ocr_cursor_register.json
*.tmp
*.part

# OCR Server runtime state, inbox and SQLite databases
inbox/
ocr/inbox/
.ocr-state/
ocr/.ocr-state/
*.sqlite3
*.lock
reports/
ocr/reports/

# OS & IDE metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
*.zip
*.tar.gz
